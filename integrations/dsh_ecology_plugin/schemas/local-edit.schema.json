{
  "$id": "ecology-local-edit@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "operations",
    "evidence_refs",
    "expected_effect_cells",
    "risk_cells"
  ],
  "properties": {
    "schema_version": {
      "const": "ecology-local-edit@1"
    },
    "decision": {
      "enum": [
        "keep",
        "mutate"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "$ref": "shared.json#/mutation_operation"
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "expected_effect_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+@[0-9]+h$"
      }
    },
    "risk_cells": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+@[0-9]+h$"
      }
    },
    "revisit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "justification"
      ],
      "properties": {
        "reason": {
          "enum": [
            "safety_recovery",
            "new_batch_evidence",
            "paired_recheck"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "keep"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "mutate"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
