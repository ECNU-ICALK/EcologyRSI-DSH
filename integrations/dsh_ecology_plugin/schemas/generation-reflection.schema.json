{
  "$id": "ecology-generation-reflection@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "lessons",
    "recommended_search_queries",
    "candidate_directions",
    "stop_recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "ecologyrsi-dsh.generation-reflection/1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "recommended_search_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "candidate_directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction_id",
          "title",
          "hypothesis",
          "target_weakness",
          "capability_focus",
          "mutation_axis",
          "mutation_target",
          "mutation_direction",
          "evidence_refs",
          "expected_tradeoff",
          "success_criterion"
        ],
        "properties": {
          "direction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "target_weakness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "capability_focus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "mutation_axis": {
            "enum": [
              "scientific_parameter",
              "registered_predictor",
              "instruction_profile",
              "instruction_parameter",
              "instruction_directive",
              "skill_program",
              "workflow_parameter",
              "feature_recipe",
              "strategy_program"
            ]
          },
          "mutation_target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "mutation_direction": {
            "enum": [
              "increase",
              "decrease",
              "select",
              "author",
              "revise"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "expected_tradeoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "success_criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "mechanism_hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "mechanism_id",
              "input_refs",
              "target_cells",
              "expected_observation_id",
              "falsification_rule_id"
            ],
            "properties": {
              "schema_version": {
                "const": "ecologyrsi-dsh.mechanism-hypothesis/1",
                "type": "string"
              },
              "mechanism_id": {
                "type": "string",
                "enum": [
                  "parameter_adjustment",
                  "prediction_structure",
                  "feature_structure",
                  "agent_decision",
                  "execution_control"
                ]
              },
              "input_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "target_cells": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "expected_observation_id": {
                "type": "string",
                "enum": [
                  "paired_error_decreases",
                  "tool_output_changes",
                  "execution_branch_exercised"
                ]
              },
              "falsification_rule_id": {
                "type": "string",
                "enum": [
                  "no_paired_error_improvement",
                  "no_tool_output_change",
                  "branch_not_exercised"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mutation_axis": {
                  "enum": [
                    "scientific_parameter",
                    "instruction_parameter",
                    "workflow_parameter"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "mutation_direction": {
                  "enum": [
                    "increase",
                    "decrease"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mutation_axis": {
                  "enum": [
                    "registered_predictor",
                    "instruction_profile"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "mutation_direction": {
                  "enum": [
                    "select"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mutation_axis": {
                  "enum": [
                    "instruction_directive",
                    "skill_program",
                    "feature_recipe"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "mutation_direction": {
                  "enum": [
                    "author",
                    "revise"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "stop_recommendation": {
      "enum": [
        "continue",
        "converged",
        "insufficient_evidence"
      ]
    }
  }
}
