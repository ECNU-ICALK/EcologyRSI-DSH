{
  "$id": "ecology-generation-reflection@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "lessons",
    "recommended_search_queries",
    "candidate_directions",
    "stop_recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "ecologyrsi-dsh.generation-reflection/1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "recommended_search_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "candidate_directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "$ref": "shared.json#/research_direction"
      }
    },
    "stop_recommendation": {
      "enum": [
        "continue",
        "converged",
        "insufficient_evidence"
      ]
    }
  }
}
