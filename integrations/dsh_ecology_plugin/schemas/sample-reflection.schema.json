{
  "$id": "ecology-sample-reflection@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_digest",
    "sample_id",
    "outcome_class",
    "error_source",
    "next_action",
    "confidence",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "ecology-sample-reflection@1"},
    "wave_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "outcome_class": {
      "type": "string",
      "enum": ["improved", "degraded", "neutral", "failed"]
    },
    "error_source": {
      "type": "string",
      "enum": ["model", "feature", "parameter", "tool", "execution", "unknown"]
    },
    "next_action": {
      "type": "string",
      "enum": ["keep", "increase", "decrease", "repair", "inspect", "stop"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
