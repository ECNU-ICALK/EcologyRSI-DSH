{
  "$id": "ecology-research-synthesis@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "evidence",
    "candidate_directions"
  ],
  "properties": {
    "schema_version": {
      "const": "ecologyrsi-dsh.research-synthesis/1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "finding",
          "relevance"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "relevance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "candidate_directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "shared.json#/research_direction"
      }
    }
  }
}
