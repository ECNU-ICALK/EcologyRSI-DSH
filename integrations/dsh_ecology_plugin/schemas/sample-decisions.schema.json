{
  "$id": "ecology-sample-predictions@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_digest",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "ecology-sample-predictions@2"
    },
    "wave_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "predicted",
          "confidence",
          "reason_code",
          "method",
          "evidence_call_ids"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "accept_prediction",
              "agent_adjusted",
              "agent_blend",
              "agent_direct",
              "agent_model",
              "baseline",
              "bounded_retry_recovered",
              "candidate_forecast",
              "critic_requested_tool",
              "critic_selects_alternate_tool",
              "critic_terminates_failed_tool",
              "critic_unavailable_connection",
              "critic_unavailable_constraint_rejected",
              "critic_unavailable_invalid_output",
              "critic_unavailable_numerical",
              "critic_unavailable_rate_limited",
              "critic_unavailable_remote_rejected",
              "critic_unavailable_remote_transient",
              "critic_unavailable_timeout",
              "critic_unavailable_tool_error",
              "fallback",
              "initial_registered_route",
              "insufficient_context",
              "persistence_baseline",
              "projection_repair",
              "registered_forecast",
              "registered_tool",
              "remote_review_accept",
              "repair_after_host_rejection",
              "request_registered_repair",
              "route",
              "stable_baseline",
              "terminate_after_tool_failure",
              "use_persistence_fallback",
              "use_projection_repair",
              "use_registered_forecast",
              "use_registered_tool"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "predicted": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "direct",
              "model",
              "blend",
              "adjusted"
            ]
          },
          "evidence_call_ids": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
