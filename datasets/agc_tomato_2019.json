  "prediction_task": {
    "adapter_id": "agc_tomato_2019@1",
    "dataset_id": "agc_tomato_2019",
    "domain_id": "greenhouse_tomato_2019",
    "label": "2019 番茄 · 环境预测",
    "climate_filename": "GreenhouseClimate.csv",
    "targets": [
      {
        "name": "air_temperature",
        "label": "室内气温",
        "unit": "degC",
        "minimum": -10.0,
        "maximum": 60.0,
        "weight": 0.3333333333333333
      },
      {
        "name": "relative_humidity",
        "label": "室内相对湿度",
        "unit": "percent",
        "minimum": 0.0,
        "maximum": 100.0,
        "weight": 0.3333333333333333
      },
      {
        "name": "co2_concentration",
        "label": "室内 CO₂ 浓度",
        "unit": "ppm",
        "minimum": 0.0,
        "maximum": 5000.0,
        "weight": 0.3333333333333333
      }
    ],
    "label_semantics": [
      "番茄一级果产量为单次采收量（kg/m²），不能与黄瓜累计产量混用。",
      "供热能耗单位为 MJ/m²/日；稀疏产量和品质标签不插值，也不计入本任务评分。"
    ],
    "horizons_hours": [
      1,
      6,
      24
    ],
    "evaluator_id": "greenhouse_multihorizon_time_forward@4",
    "domain_pack_id": "greenhouse_environment@1",
    "minimum_coverage": 0.8,
    "selection_minimum_coverage": 0.9,
    "minimum_skill": 1e-09,
    "no_regression_tolerance": 1e-12,
    "maximum_constraint_violations": 0,
    "selection_minimum_score_delta": 0.005,
    "primary_metric": "weighted_symmetric_rmse_skill@1",
    "diagnostic_metrics": [
      "mae",
      "rmse",
      "bias",
      "normalized_rmse",
      "skill_score",
      "sample_execution_coverage",
      "constraint_violations"
    ]
  }
