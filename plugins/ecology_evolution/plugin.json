{
  "plugin_id": "ecologyrsi.evolution",
  "plugin_api_version": "dsh-plugin/v1",
  "display_name": "生态模型进化工作台",
  "version": "0.3.15",
  "development_only": false,
  "release_stage": "delivery-candidate",
  "description": "用于配置、监控、异步专家咨询和人工协作的模型自主调研、受限能力编译、评测与优化插件。",
  "dsh_compatibility": {
    "integration_mode": "static-webview-with-backend-proxy",
    "context_message": "dsh.context",
    "context_protocol": "ecology-evolution.host-context/1",
    "backend_mode": "independent-service",
    "recommended_proxy_base": "/api/ecology-evolution",
    "formal_protocol_status": "pending-host-integration"
  },
  "entrypoint": { "type": "webview", "route": "/plugins/ecology/evolution/", "file": "index.html" },
  "modes": [{ "id": "evolution", "label": "模型自研进化模式", "start_command": "evolution.start", "resume_command": "evolution.resume" }],
  "permissions": [
    "evolution.catalog.read",
    "evolution.run.create",
    "evolution.run.advance",
    "evolution.projection.read",
    "evaluation.samples.read",
    "training.data.read",
    "run.control",
    "run.archive",
    "run.delete",
    "intervention.write"
  ],
  "denied_capabilities": ["hidden.read", "final.read", "evaluator.write", "gate.write", "release.write", "secret.read", "physical.actuate", "network.any"],
  "events": ["run.*", "generation.*", "candidate.*", "evaluation.*", "promotion.*", "intervention.*", "expert_consultation.*", "stage.*", "research.*", "implementation.*", "optimization.*"],
  "api": {
    "default_base": "/api",
    "supported_bases": ["/api", "/api/v1", "/api/ecology-evolution", "/api/ecology-evolution/v1"],
    "health": "/health",
    "catalog": "/catalog",
    "datasets": "/datasets/{dataset_id}",
    "dataset_samples": "/datasets/{dataset_id}/samples",
    "runs": "/runs",
    "events": "/runs/{run_id}/events",
    "samples": "/runs/{run_id}/samples?candidate_id={candidate_id}&offset={offset}&limit={limit}",
    "advance": "/runs/{run_id}/advance",
    "control": "/runs/{run_id}/control",
    "archive": "/runs/{run_id}/archive",
    "restore": "/runs/{run_id}/restore",
    "delete": "/runs/{run_id}",
    "interventions": "/runs/{run_id}/interventions",
    "expert_consultation_answer": "/runs/{run_id}/expert-consultations/{consultation_id}/answer"
  },
  "security": {
    "token_audience": "ecology-evolution",
    "token_scope": "service-process",
    "scope_enforcement": "single-process-static-token-all-service-capabilities",
    "formal_task_run_session_scope": false,
    "context_transport": "parent-post-message",
    "host_identity_mapping": "display-only-and-intervention-and-consultation-attribution",
    "host_capability_mapping": "ui-intersection-only-no-server-scope-enforcement",
    "host_model_mapping": "registered-model-match-only",
    "content_security_policy": "default-src 'self'; connect-src 'self'",
    "secrets_in_browser": false,
    "capability_token_storage": "memory-only",
    "explicit_parent_origin_parameter": "parent_origin",
    "persist_context": false
  },
  "integrity": { "status": "delivery-candidate-unsigned", "bundle_sha256": null, "sbom_sha256": null, "signature": null }
}
